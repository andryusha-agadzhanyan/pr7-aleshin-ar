digraph C {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.45, ranksep=0.55, splines=polyline];
  node [shape=plain, style=filled, fillcolor="#F5F5F5", color="#444444", fontname="Times New Roman", fontsize=16, margin="0.12,0.09"];
  edge [fontname="Times New Roman", fontsize=14, color="#555555", arrowsize=0.7];
  self [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#444444" BGCOLOR="#F5F5F5"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>SelfCheck</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- passed, failed: int, static</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ main(args: String[]): void, static<BR ALIGN="LEFT"/>- runUnitChecks(): void, static<BR ALIGN="LEFT"/>- runDataChecks(file: Path): void, static<BR ALIGN="LEFT"/>- runInteractive(): void, static</TD></TR></TABLE>>];
  service [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#444444" BGCOLOR="#F5F5F5"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>OrderService<BR ALIGN="LEFT"/>без полей</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ createOrder(employee: Employee)<BR ALIGN="LEFT"/>    : Order<BR ALIGN="LEFT"/>+ addTotalCategory(order: Order)<BR ALIGN="LEFT"/>    : String</TD></TR></TABLE>>];
  order [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#444444" BGCOLOR="#F5F5F5"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Order</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ CONFIRM_LIMIT: double = 500000<BR ALIGN="LEFT"/>    static final<BR ALIGN="LEFT"/>- employee: Employee, final<BR ALIGN="LEFT"/>- items: List[OrderItem], final<BR ALIGN="LEFT"/>- status: OrderStatus</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Order(employee: Employee)<BR ALIGN="LEFT"/>+ addProduct(product: Product,<BR ALIGN="LEFT"/>    quantity: int): void<BR ALIGN="LEFT"/>+ removeProduct(productId: String)<BR ALIGN="LEFT"/>    : void<BR ALIGN="LEFT"/>+ total(): double<BR ALIGN="LEFT"/>+ confirm(): void<BR ALIGN="LEFT"/>+ getItems(): List[OrderItem]<BR ALIGN="LEFT"/>+ getStatus(): OrderStatus<BR ALIGN="LEFT"/>+ getEmployee(): Employee<BR ALIGN="LEFT"/>- checkDraft(): void</TD></TR></TABLE>>];
  employee [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#444444" BGCOLOR="#F5F5F5"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Employee<BR ALIGN="LEFT"/>«record»</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: String, final<BR ALIGN="LEFT"/>- fullName: String, final</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Employee(id: String,<BR ALIGN="LEFT"/>    fullName: String)<BR ALIGN="LEFT"/>+ id(): String<BR ALIGN="LEFT"/>+ fullName(): String</TD></TR></TABLE>>];
  status [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#444444" BGCOLOR="#F5F5F5"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>OrderStatus<BR ALIGN="LEFT"/>«enum»</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">DRAFT<BR ALIGN="LEFT"/>CONFIRMED</TD></TR></TABLE>>];
  item [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#444444" BGCOLOR="#F5F5F5"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>OrderItem</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ MAX_QUANTITY: int = 100<BR ALIGN="LEFT"/>    static final<BR ALIGN="LEFT"/>- product: Product, final<BR ALIGN="LEFT"/>- quantity: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ OrderItem(product: Product,<BR ALIGN="LEFT"/>    quantity: int)<BR ALIGN="LEFT"/>- setQuantity(quantity: int): void<BR ALIGN="LEFT"/>+ increase(delta: int): void<BR ALIGN="LEFT"/>+ getProduct(): Product<BR ALIGN="LEFT"/>+ getQuantity(): int<BR ALIGN="LEFT"/>+ getLineTotal(): double</TD></TR></TABLE>>];
  product [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#444444" BGCOLOR="#F5F5F5"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Product</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: String, final<BR ALIGN="LEFT"/>- name: String, final<BR ALIGN="LEFT"/>- price: double, final</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Product(id: String, name: String,<BR ALIGN="LEFT"/>    price: double)<BR ALIGN="LEFT"/>+ getId(): String<BR ALIGN="LEFT"/>+ getName(): String<BR ALIGN="LEFT"/>+ getPrice(): double</TD></TR></TABLE>>];
  self -> service [label="вызывает", style=dashed];
  self -> order [label="проверяет", style=dashed];
  service -> order [label="создаёт и анализирует", style=dashed];
  order -> employee [label="1", dir=both, arrowtail=odiamond, arrowhead=none];
  order -> item [label="0..*", dir=both, arrowtail=diamond, arrowhead=none];
  order -> status [label="статус", style=dashed];
  item -> product [label="1", arrowhead=vee];
  {rank=same; self; service;}
  {rank=same; order; item;}
  {rank=same; employee; status; product;}
}
